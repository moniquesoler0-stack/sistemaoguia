# Modelo das variáveis de ambiente. Copie para .env e preencha.
#   cp .env.example .env
# O .env real fica fora do git.

# Supabase, painel: Settings -> API Keys
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="SEU-PROJETO"

SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="SEU-PROJETO"

# Segredo: ignora o RLS, só no servidor.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Segredo: usado apenas para rodar migrações (supabase db push).
SUPABASE_DB_URL="postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Token combinado com a Kiwify para autenticar o webhook de pagamento.
KIWIFY_WEBHOOK_TOKEN="uma-senha-longa-e-aleatoria"
